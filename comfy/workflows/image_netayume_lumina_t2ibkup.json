import requests
import json
import time
import uuid

COMFY_URL = "http://127.0.0.1:8188/prompt"

def workflow_to_prompt(workflow):
    """
    Convert ComfyUI workflow JSON to API prompt format
    """
    prompt = {}

    for node in workflow["nodes"]:
        node_id = str(node["id"])
        class_type = node["type"]

        inputs = {}

        # widgets_values map to inputs (basic case)
        if "widgets_values" in node:
            if class_type == "CLIPTextEncode":
                inputs["text"] = node["widgets_values"][0]

        prompt[node_id] = {
            "class_type": class_type,
            "inputs": inputs
        }

    return prompt


def generate_image(workflow_path):
    with open(workflow_path, "r") as f:
        workflow = json.load(f)

    prompt_graph = workflow_to_prompt(workflow)

    payload = {
        "prompt": prompt_graph,
        "client_id": str(uuid.uuid4())
    }

    response = requests.post(COMFY_URL, json=payload)
    response.raise_for_status()

    prompt_id = response.json()["prompt_id"]
    print(f"Comfy job submitted: {prompt_id}")

    time.sleep(8)
    return True
